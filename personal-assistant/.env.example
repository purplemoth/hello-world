# Copy this file to a new file called .env and fill in the two keys below.
# Never share your .env file with anyone.

# From https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=paste-your-claude-key-here

# From Todoist -> Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=paste-your-todoist-token-here

# Optional: your home time zone (used for calendar entries)
TIME_ZONE=Europe/London
